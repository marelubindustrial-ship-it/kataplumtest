{
  "name": "kataplum-parque",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio web de Kataplum - parque de diversiones con mapa interactivo, venta de boletos y asistente virtual",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && rm -rf dist && cp -r out dist",
    "start": "npx -y serve@latest dist -l 3000",
    "lint": "next lint"
  },
  "dependencies": {
